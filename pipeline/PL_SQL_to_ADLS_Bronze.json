                "dependsOn": [
                    {
                        "activity": "ForEach_Table",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "Destination",
                        "type": "DatasetReference",
                        "parameters": {
                            "FolderName": "health_insurance_claims",
                            "FileName": "synthetic_health_claims.csv"
                        }
                    },
                    "fieldList": [
                        "size",
                        "exists",
                        "lastModified"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "DelimitedTextReadSettings"
                    }
                }
            },
            {
                "name": "r If_Bronze_File_Valid",
