                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "storedProcedureName": "dbo.usp_log_pipeline_run",
                    "storedProcedureParameters": {
                        "pipeline_name": {
                            "value": {
                                "value": "PL_SQL_to_ADLS_Bronze",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "run_id": {
